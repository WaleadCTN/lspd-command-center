rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function hasSiteAccess() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != "En attente"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != "Refusé"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != "Archivé"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != "Suspendu";
    }

    function myProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function myRole() { return signedIn() ? myProfile().data.role : null; }
    function myStatus() { return signedIn() ? myProfile().data.status : null; }
    function myGrade() { return signedIn() ? myProfile().data.grade : null; }
    function myPermissionGrade() {
      let g = myGrade();
      return g == "PO1" ? "Police Officer1" :
        g == "PO2" ? "Police Officer2" :
        g == "PO3" ? "Police Officer3" :
        g == "Sergent" ? "Sergeant1" :
        g == "Deputy Chief" ? "Deputy Chief of Police" : g;
    }
    function isVisitor() { return hasSiteAccess() && myRole() == "Visiteur"; }
    function isApplicant() { return hasSiteAccess() && myRole() == "Applicant"; }
    function isInactive() { return hasSiteAccess() && myStatus() == "Inactif" && myRole() != "Visiteur" && myRole() != "Applicant"; }
    function isInternal() { return hasSiteAccess() && myRole() != "Visiteur" && myRole() != "Applicant" && myStatus() != "Inactif"; }

    function navAllowed(group) {
      let navRef = /databases/$(database)/documents/settings/navigation_visibility;
      return isInternal() && (
        isChief() ||
        !exists(navRef) ||
        !get(navRef).data.keys().hasAny(["groups"]) ||
        !get(navRef).data.groups.keys().hasAny([group]) ||
        get(navRef).data.groups[group].hasAny([myGrade(), myPermissionGrade()])
      );
    }

    // Permissions are resolved by canonical grade. Roles remain technical labels only
    // (Visitor / Applicant / FTO display) and never grant command permissions.
    function isChief() { return isInternal() && myPermissionGrade() == "Chief of Police"; }

    function isLieutenantPlus() { return isInternal() && ["Lieutenant","Commander","Captain","Deputy Chief of Police","Assistant Chief","Chief of Police","Commissioner"].hasAny([myPermissionGrade()]); }
    function canManageFtoAssignments() { return isChief() || (isLieutenantPlus() && hasPerm("fto_assignments_manage")); }
    function gradeRank(g) {
      return g == "Rookie" ? 1 :
        g == "Police Officer1" || g == "PO1" ? 2 :
        g == "Police Officer2" || g == "PO2" ? 3 :
        g == "Police Officer3" || g == "PO3" ? 4 :
        g == "Senior Lead Officer" ? 5 :
        g == "Detective1" ? 6 :
        g == "Detective2" ? 7 :
        g == "Detective3" ? 8 :
        g == "Sergeant1" || g == "Sergent" ? 9 :
        g == "Sergeant2" ? 10 :
        g == "Lieutenant" ? 11 :
        g == "Commander" ? 12 :
        g == "Captain" ? 13 :
        g == "Deputy Chief of Police" || g == "Deputy Chief" ? 14 :
        g == "Assistant Chief" ? 15 :
        g == "Chief of Police" ? 16 :
        g == "Commissioner" ? 17 : 0;
    }
    function validFtoAssignmentData(data) {
      return data.ftoId is string
        && data.traineeId is string
        && data.ftoId != data.traineeId
        && exists(/databases/$(database)/documents/users/$(data.ftoId))
        && exists(/databases/$(database)/documents/users/$(data.traineeId))
        && (get(/databases/$(database)/documents/users/$(data.ftoId)).data.role == "FTO" || gradeRank(get(/databases/$(database)/documents/users/$(data.ftoId)).data.grade) >= gradeRank("Sergeant1"))
        && get(/databases/$(database)/documents/users/$(data.ftoId)).data.role != "Visiteur"
        && get(/databases/$(database)/documents/users/$(data.ftoId)).data.role != "Applicant"
        && get(/databases/$(database)/documents/users/$(data.traineeId)).data.role != "Visiteur"
        && get(/databases/$(database)/documents/users/$(data.traineeId)).data.role != "Applicant"
        && ["Actif","En formation"].hasAny([get(/databases/$(database)/documents/users/$(data.ftoId)).data.status])
        && ["Actif","En formation"].hasAny([get(/databases/$(database)/documents/users/$(data.traineeId)).data.status])
        && gradeRank(get(/databases/$(database)/documents/users/$(data.traineeId)).data.grade) > 0
        && gradeRank(get(/databases/$(database)/documents/users/$(data.ftoId)).data.grade) > 0
        && gradeRank(get(/databases/$(database)/documents/users/$(data.traineeId)).data.grade) <= gradeRank(get(/databases/$(database)/documents/users/$(data.ftoId)).data.grade);
    }
    function canReadRecruitment() {
      return hasPerm("recruitment_view") || hasPerm("recruitment_screening") || hasPerm("recruitment_interview_schedule") || hasPerm("recruitment_interview_evaluate") || hasPerm("recruitment_command_decision") || hasPerm("recruitment_incorporate");
    }
    function canReadMdtCases() { return hasPerm("mdt_manage") || hasPerm("mdt_case_create") || hasPerm("mdt_case_close"); }
    function directoryAccess() {
      return isChief() || hasPerm("personnel_view") || hasPerm("personnel_manage") || hasPerm("personnel_grade_manage") || hasPerm("personnel_status_manage") || hasPerm("personnel_create") || hasPerm("personnel_delete")
        || hasPerm("registrations_manage") || hasPerm("registrations_approve") || hasPerm("registrations_reject")
        || canReadRecruitment()
        || hasPerm("messages_access") || hasPerm("fto_tools") || hasPerm("fto_evaluations_create") || hasPerm("fto_assignments_view") || hasPerm("fto_assignments_manage")
        || hasPerm("fto_sessions_manage") || hasPerm("fto_objectives_manage") || hasPerm("fto_handoffs_manage") || hasPerm("academy_manage") || hasPerm("academy_final_review")
        || hasPerm("certifications_view") || hasPerm("certifications_manage") || hasPerm("records_view") || hasPerm("records_manage") || hasPerm("analytics")
        || hasPerm("shifts_view") || hasPerm("shifts_manage") || hasPerm("duty_board") || hasPerm("leave_review")
        || hasPerm("training_manage") || hasPerm("training_invites_manage") || hasPerm("training_attendance_manage")
        || hasPerm("promotions_view") || hasPerm("promotions_manage") || hasPerm("division_review") || hasPerm("provisional_credentials_view");
    }

    function defaultHasPerm(permission) {
      let g = myPermissionGrade();
      let selfServiceDefaults = ["messages_access","incident_create","corrections_create","training_access","training_self_register","leave_request_create","cad_access","bolo_view"];
      let commandDefaults = [
        "fto_tools","fto_evaluations_create","fto_sessions_manage","fto_objectives_manage","fto_handoffs_manage","personnel_view","fto_assignments_view","certifications_view",
        "records_view","shifts_view","duty_board","leave_review","training_manage","training_invites_manage","training_attendance_manage",
        "incident_view_all","incident_review","incident_export","corrections_review","mdt_manage","mdt_case_create","mdt_case_close","recruitment_view","recruitment_screening","recruitment_interview_schedule","recruitment_interview_evaluate","promotions_view","analytics","audit",
        "announcements_manage","cad_manage","bolo_manage","watch_view","watch_manage","academy_manage","academy_content_manage","academy_final_review"
      ];
      return isChief()
        || (selfServiceDefaults.hasAny([permission]))
        || (isLieutenantPlus() && ["fto_assignments_view","fto_assignments_manage"].hasAny([permission]))
        || (["Sergeant1","Sergeant2","Lieutenant","Commander","Captain","Deputy Chief of Police","Assistant Chief","Commissioner"].hasAny([g]) && commandDefaults.hasAny([permission]));
    }

    function configuredHasPerm(permission) {
      let cfg = get(/databases/$(database)/documents/settings/permissions).data;
      let g = myPermissionGrade();
      return cfg.keys().hasAny(["grades"])
        && cfg.grades.keys().hasAny([g])
        && cfg.grades[g].hasAny([permission]);
    }

    function hasPerm(permission) {
      let permissionRef = /databases/$(database)/documents/settings/permissions;
      // Navigation visibility and security permissions are intentionally independent.
      // Hiding a sidebar category never corrupts an otherwise valid permission matrix.
      // Chief of Police keeps an absolute security bypass.
      return isChief() || (isInternal() && (
        exists(permissionRef) && get(permissionRef).data.keys().hasAny(["grades"])
          ? configuredHasPerm(permission)
          : defaultHasPerm(permission)
      ));
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        isChief() ||
        (directoryAccess() && resource.data.role != "Visiteur")
      );

      allow create: if signedIn() && (
        (
          request.auth.uid == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 3
          && request.resource.data.name.size() <= 60
          && request.resource.data.badge == "—"
          && request.resource.data.registeredEmail == request.auth.token.email
          && request.resource.data.selfRegistered == true
          && request.resource.data.grade == "Candidat"
          && request.resource.data.role == "Applicant"
          && request.resource.data.status == "Candidature"
          && request.resource.data.division == "Recruitment"
          && request.resource.data.recruitmentApplicant == true
        ) || (
          hasPerm("personnel_create")
          && request.auth.uid != userId
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 3
          && request.resource.data.name.size() <= 60
          && request.resource.data.registeredEmail is string
          && request.resource.data.badge == "—"
          && request.resource.data.grade == "Rookie"
          && request.resource.data.role == "Officer"
          && request.resource.data.status == "En formation"
          && request.resource.data.division == "Patrol"
          && request.resource.data.importedAccount == true
          && request.resource.data.mustChangePassword == true
          && request.resource.data.selfRegistered == false
          && request.resource.data.provisionedById == request.auth.uid
          && (request.resource.data.chiefProvisioned == true || request.resource.data.managerProvisioned == true)
        )
      );

      // First activation is self-service and independent from grade/menu permissions.
      allow update: if (
        signedIn() && request.auth.uid == userId && resource.data.mustChangePassword == true
        && request.resource.data.mustChangePassword == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["mustChangePassword","passwordChangedAt","updatedAt"])
      ) || isChief() || (
        hasPerm("registrations_approve") && resource.data.status in ["En attente","Refusé"]
        && request.resource.data.status == "Actif"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["badge","grade","role","division","status","approvedById","approvedByName","approvedAt","updatedAt"])
      ) || (
        hasPerm("registrations_reject") && resource.data.status == "En attente" && request.resource.data.status == "Refusé"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","rejectedById","rejectedByName","rejectedAt","updatedAt"])
      ) || (
        hasPerm("recruitment_incorporate") && resource.data.role == "Applicant" && request.resource.data.role == "Officer" && request.resource.data.status == "Actif"
        && request.resource.data.recruitmentApplicant == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["badge","grade","role","status","division","recruitmentApplicant","recruitedAt","recruitedById","recruitedByName","updatedAt"])
      ) || (
        hasPerm("division_review")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["division","updatedAt"])
      ) || (
        hasPerm("promotions_manage")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["grade","updatedAt"])
      ) || (
        (hasPerm("personnel_manage") || hasPerm("personnel_grade_manage") || hasPerm("personnel_status_manage"))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["badge","name","role","division"]) || hasPerm("personnel_manage"))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["grade"]) || hasPerm("personnel_grade_manage"))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["status"]) || hasPerm("personnel_status_manage"))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["badge","name","role","division","grade","status","updatedAt"])
      );

      allow delete: if hasPerm("personnel_delete") && request.auth.uid != userId;
    }

    // Protected vault for temporary activation codes.
    // Passwords cannot be read back from Firebase Authentication, so only
    // the temporary credential generated at provisioning/import time is kept here.
    // Direct document reads only: listing the whole vault is always forbidden.
    match /provisional_credentials/{userId} {
      allow get: if hasPerm("provisional_credentials_view")
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.importedAccount == true
        && get(/databases/$(database)/documents/users/$(userId)).data.mustChangePassword == true;
      allow list: if false;
      allow create: if hasPerm("personnel_create")
        && request.resource.data.userId == userId
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.temporaryPassword is string
        && request.resource.data.temporaryPassword.size() >= 8;
      allow update: if false;
      allow delete: if (signedIn() && request.auth.uid == userId) || hasPerm("personnel_delete") || isChief();
    }

    match /announcements/{id} {
      allow read: if (isInternal() && navAllowed("communication")) || isInactive() || (isVisitor() && resource.data.visibility == "Public");
      allow create: if hasPerm("announcements_manage") && request.resource.data.authorId == request.auth.uid;
      allow update: if hasPerm("announcements_manage");
      allow delete: if false;
    }

    match /messages/{id} {
      allow read: if hasPerm("messages_access") && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );

      allow create: if hasPerm("messages_access")
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string;

      // The recipient may only change read state, like an email inbox.
      allow update: if hasPerm("messages_access")
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "read","readAt"
        ]);

      allow delete: if false;
    }

    match /incident_reports/{id} {
      allow create: if hasPerm("incident_create")
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == "En attente";

      allow read: if (
        (hasPerm("incident_create") && resource.data.authorId == request.auth.uid)
        || hasPerm("incident_view_all") || hasPerm("incident_review") || hasPerm("incident_export")
      );

      allow update: if hasPerm("incident_review")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status","approvedById","approvedByName","approvedAt","signature"
        ]);
      allow delete: if false;
    }

    match /evaluations/{id} {
      allow read: if isInternal() && (
        resource.data.officerId == request.auth.uid ||
        resource.data.ftoId == request.auth.uid ||
        hasPerm("fto_tools") || hasPerm("personnel_view") || hasPerm("academy_manage") || hasPerm("academy_final_review") || hasPerm("training_manage") || hasPerm("analytics")
      );
      allow create: if hasPerm("fto_evaluations_create")
        && request.resource.data.ftoId == request.auth.uid
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100;
      allow update, delete: if false;
    }

    match /fto_assignments/{id} {
      // A trainee may read only their own assignment so the Training Center
      // can show who their active FTO is. FTO/Command keep their existing access.
      allow read: if isInternal() && (
        resource.data.traineeId == request.auth.uid || resource.data.ftoId == request.auth.uid ||
        hasPerm("fto_tools") || hasPerm("fto_assignments_view") || hasPerm("fto_assignments_manage") || hasPerm("analytics")
      );
      allow create: if canManageFtoAssignments()
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.status == "Active"
        && validFtoAssignmentData(request.resource.data);
      allow update: if canManageFtoAssignments()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status","closedAt","closedById","closedByName","updatedAt"
        ]);
      allow delete: if false;
    }

    match /certifications/{id} {
      // Internal certification directory is readable by all department members
      // so mail recipients can be resolved by certification.
      // Visitors remain excluded because isInternal() is false for them.
      allow read: if isInternal() && (
        resource.data.officerId == request.auth.uid || hasPerm("certifications_view") || hasPerm("certifications_manage") || hasPerm("messages_access") || hasPerm("training_access") || hasPerm("analytics")
      );
      allow create: if hasPerm("certifications_manage") && request.resource.data.issuedById == request.auth.uid;
      allow update, delete: if false;
    }

    match /personnel_records/{id} {
      allow read: if isInternal() && (
        resource.data.officerId == request.auth.uid || hasPerm("records_view") || hasPerm("records_manage") || hasPerm("analytics")
      );
      allow create: if hasPerm("records_manage") && request.resource.data.issuedById == request.auth.uid;
      allow update, delete: if false;
    }

    match /shifts/{id} {
      allow read: if isInternal() && (
        resource.data.officerId == request.auth.uid || hasPerm("shifts_view") || hasPerm("shifts_manage") || hasPerm("duty_board") || hasPerm("analytics")
      );
      allow create: if hasPerm("shifts_manage") && request.resource.data.createdById == request.auth.uid;

      allow update: if (
        hasPerm("shifts_manage")
      ) || (
        isInternal()
        && resource.data.officerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "dutyStatus","checkInAt","checkOutAt"
        ])
      );

      allow delete: if false;
    }

    match /leave_requests/{id} {
      allow create: if hasPerm("leave_request_create") && request.resource.data.officerId == request.auth.uid;
      allow read: if isInternal() && (
        (hasPerm("leave_request_create") && resource.data.officerId == request.auth.uid) || hasPerm("leave_review") || hasPerm("duty_board") || hasPerm("analytics")
      );
      allow update: if hasPerm("leave_review");
      allow delete: if false;
    }

    match /training_events/{id} {
      allow read: if hasPerm("training_access") || hasPerm("training_manage") || hasPerm("training_invites_manage") || hasPerm("training_attendance_manage") || hasPerm("duty_board") || hasPerm("fto_tools");
      allow create: if hasPerm("training_manage") && request.resource.data.trainerId == request.auth.uid;

      allow update: if hasPerm("training_manage")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status","completedAt","completedById","completedByName"
        ])
        && request.resource.data.status == "Terminée"
        && request.resource.data.completedById == request.auth.uid;

      allow delete: if false;
    }

    match /promotions/{id} {
      allow read: if hasPerm("promotions_view") || hasPerm("promotions_manage");
      allow create: if hasPerm("promotions_manage") && request.resource.data.approvedById == request.auth.uid;
      allow update, delete: if false;
    }

    match /audit_logs/{id} {
      allow read: if hasPerm("audit");
      allow create: if isInternal() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }


    match /notifications/{id} {
      allow read: if isInternal() && resource.data.recipientId == request.auth.uid;

      allow create: if isInternal()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.read == false;

      allow update: if isInternal()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "read","readAt"
        ]);

      allow delete: if false;
    }

    match /correction_requests/{id} {
      allow create: if hasPerm("corrections_create")
        && request.resource.data.requestedById == request.auth.uid
        && request.resource.data.status == "En attente";

      allow read: if (
        (hasPerm("corrections_create") && resource.data.requestedById == request.auth.uid) ||
        hasPerm("corrections_review")
      );

      allow update: if hasPerm("corrections_review")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status","reviewedById","reviewedByName","reviewedAt"
        ]);

      allow delete: if false;
    }

    match /amendments/{id} {
      allow read: if hasPerm("incident_create") || hasPerm("incident_view_all") || hasPerm("incident_review") || hasPerm("corrections_create") || hasPerm("corrections_review");

      allow create: if hasPerm("corrections_review")
        && request.resource.data.approvedById == request.auth.uid
        && request.resource.data.sourceCorrectionId is string;

      allow update, delete: if false;
    }


    match /training_registrations/{id} {
      allow read: if signedIn() && (
        ((hasPerm("training_access") || hasPerm("training_self_register")) && resource.data.officerId == request.auth.uid) ||
        hasPerm("training_manage") || hasPerm("training_invites_manage") || hasPerm("training_attendance_manage") || hasPerm("duty_board") || hasPerm("fto_tools")
      );

      // Self-registration OR a training manager inviting another internal member.
      allow create: if isInternal() && (
        (
          hasPerm("training_self_register")
          && request.resource.data.officerId == request.auth.uid
          && request.resource.data.status == "Inscrit"
        ) || (
          hasPerm("training_invites_manage")
          && request.resource.data.invitedById == request.auth.uid
          && request.resource.data.status == "Invité"
          && request.resource.data.attendanceStatus == "Invité"
        )
      );

      // The invitee can accept/decline/cancel only their own registration.
      allow update: if (
        isInternal()
        && resource.data.officerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status","attendanceStatus","cancelledAt","respondedAt"
        ])
      ) || (
        hasPerm("training_attendance_manage")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "attendanceStatus","attendanceMarkedById","attendanceMarkedByName","attendanceMarkedAt"
        ])
      );

      allow delete: if false;
    }

    match /case_files/{id} {
      allow read: if canReadMdtCases();

      allow create: if hasPerm("mdt_case_create")
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.status == "Ouvert";

      allow update: if hasPerm("mdt_case_close")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status","closedById","closedByName","closedAt"
        ]);

      allow delete: if false;
    }

    match /division_applications/{id} {
      allow create: if navAllowed("personnel")
        && request.resource.data.applicantId == request.auth.uid
        && request.resource.data.status == "En attente";

      allow read: if navAllowed("personnel") && (
        resource.data.applicantId == request.auth.uid ||
        hasPerm("division_review")
      );

      allow update: if hasPerm("division_review")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status","reviewedById","reviewedByName","reviewedAt"
        ]);

      allow delete: if false;
    }


    function recruitmentApplicationsOpen() {
      let recruitmentRef = /databases/$(database)/documents/public_settings/recruitment;
      return !exists(recruitmentRef) || get(recruitmentRef).data.open == true;
    }

    match /lspd_applications/{id} {
      allow create: if signedIn()
        && recruitmentApplicationsOpen()
        && request.auth.uid == id
        && request.resource.data.applicantId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "Dossier reçu"
        && request.resource.data.interviewStatus == "À planifier";

      // Applicant can read their public application document. Internal notes/scores
      // are stored separately in lspd_recruitment_reviews and are never applicant-readable.
      allow read: if signedIn() && (
        resource.data.applicantId == request.auth.uid
        || canReadRecruitment()
      );

      allow update: if (
        signedIn()
        && resource.data.applicantId == request.auth.uid
        && resource.data.status in ["Dossier reçu","En étude","Pré-sélectionné","À convoquer"]
        && request.resource.data.status == "Retirée"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","withdrawnAt","updatedAt"])
      ) || (
        hasPerm("recruitment_screening")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status","reviewedById","reviewedByName","reviewedAt","publicMessage","updatedAt"
        ])
      ) || (
        hasPerm("recruitment_interview_schedule")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status","interviewStatus","interviewDate","interviewTime","interviewLocation",
          "interviewPublicInstructions","interviewerId","interviewerName","interviewScheduledAt",
          "publicMessage","updatedAt"
        ])
      ) || (
        hasPerm("recruitment_interview_evaluate")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status","interviewStatus","publicMessage","updatedAt"
        ])
      ) || (
        hasPerm("recruitment_command_decision")
        && request.resource.data.status in ["Admission approuvée","Refusé"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status","publicMessage","publicDecisionMessage","decisionById","decisionByName","decisionAt","updatedAt"
        ])
      ) || (
        hasPerm("recruitment_incorporate")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status","recruitmentBadge","recruitmentGrade","recruitmentDivision",
          "recruitedById","recruitedByName","recruitedAt","publicMessage","updatedAt"
        ])
      );

      allow delete: if false;
    }

    match /lspd_recruitment_reviews/{id} {
      allow read: if canReadRecruitment();

      allow create: if request.resource.data.applicationId == id && (
        (hasPerm("recruitment_screening") && request.resource.data.keys().hasOnly([
          "applicationId","screeningScores","screeningCriteria","screeningTotal","screeningNotes","screeningOutcome",
          "screenedById","screenedByName","screenedAt","createdAt","updatedAt"
        ])) ||
        (hasPerm("recruitment_interview_evaluate") && request.resource.data.keys().hasOnly([
          "applicationId","interviewQuestions","interviewNotes","interviewScores","interviewCriteria","interviewTotal",
          "interviewStrengths","interviewConcerns","interviewSummary","interviewRecommendation",
          "interviewedById","interviewedByName","interviewCompletedAt","createdAt","updatedAt"
        ])) ||
        (hasPerm("recruitment_command_decision") && request.resource.data.keys().hasOnly([
          "applicationId","commandDecision","commandDecisionNotes","commandById","commandByName","commandDecisionAt","createdAt","updatedAt"
        ])) ||
        (hasPerm("recruitment_incorporate") && request.resource.data.keys().hasOnly([
          "applicationId","incorporationNote","incorporatedById","incorporatedByName","incorporatedAt","createdAt","updatedAt"
        ]))
      );

      allow update: if (
        hasPerm("recruitment_screening")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "screeningScores","screeningCriteria","screeningTotal","screeningNotes","screeningOutcome",
          "screenedById","screenedByName","screenedAt","updatedAt"
        ])
      ) || (
        hasPerm("recruitment_interview_evaluate")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "interviewQuestions","interviewNotes","interviewScores","interviewCriteria","interviewTotal",
          "interviewStrengths","interviewConcerns","interviewSummary","interviewRecommendation",
          "interviewedById","interviewedByName","interviewCompletedAt","updatedAt"
        ])
      ) || (
        hasPerm("recruitment_command_decision")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "commandDecision","commandDecisionNotes","commandById","commandByName","commandDecisionAt","updatedAt"
        ])
      ) || (
        hasPerm("recruitment_incorporate")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "incorporationNote","incorporatedById","incorporatedByName","incorporatedAt","updatedAt"
        ])
      );

      allow delete: if false;
    }

    match /public_settings/{settingId} {
      // Public recruitment switch: safe to read before login so the application
      // button can disappear immediately when recruitment is closed.
      allow read: if settingId == "recruitment";
      allow create, update: if settingId == "recruitment"
        && hasPerm("recruitment_settings_manage")
        && request.resource.data.open is bool
        && request.resource.data.updatedById == request.auth.uid
        && request.resource.data.keys().hasOnly(["open","updatedById","updatedByName","updatedAt"]);
      allow delete: if false;
    }

    match /settings/{settingId} {
      allow read: if isInternal();
      allow create, update: if isChief() && settingId in ["permissions","navigation_visibility"];
      allow delete: if false;
    }

    match /cad_units/{id} {
      allow read: if hasPerm("cad_access") || hasPerm("cad_manage");

      allow create: if (hasPerm("cad_access") || hasPerm("cad_manage")) && (
        request.resource.data.ownerId == request.auth.uid ||
        hasPerm("cad_manage")
      );

      allow update: if (hasPerm("cad_access") || hasPerm("cad_manage")) && (
        (
          resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "callSign","partnerName","division","status","location","note","active","updatedAt"
          ])
        ) || hasPerm("cad_manage")
      );

      allow delete: if false;
    }

    match /bolos/{id} {
      allow read: if hasPerm("bolo_view") || hasPerm("bolo_manage");
      allow create: if hasPerm("bolo_manage")
        && request.resource.data.createdById == request.auth.uid;
      allow update: if hasPerm("bolo_manage");
      allow delete: if false;
    }

    match /watch_sessions/{id} {
      allow read: if hasPerm("watch_view") || hasPerm("watch_manage");
      allow create: if hasPerm("watch_manage")
        && request.resource.data.startedById == request.auth.uid;
      allow update: if hasPerm("watch_manage");
      allow delete: if false;
    }


    match /fto_sessions/{id} {
      allow read: if isInternal() && (
        resource.data.traineeId == request.auth.uid || resource.data.ftoId == request.auth.uid || hasPerm("fto_tools") || hasPerm("fto_sessions_manage") || hasPerm("academy_manage") || hasPerm("academy_final_review") || hasPerm("analytics")
      );

      allow create: if hasPerm("fto_sessions_manage")
        && request.resource.data.ftoId == request.auth.uid
        && request.resource.data.status == "En cours";

      allow update: if hasPerm("fto_sessions_manage")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "checklist","summary","strengths","improvements","nextGoals",
          "status","completedAt","endedAt","endedById","endedByName","notes","updatedAt"
        ]);
      allow delete: if false;
    }

    match /training_objectives/{id} {
      allow read: if isInternal() && (
        resource.data.traineeId == request.auth.uid || resource.data.createdById == request.auth.uid || hasPerm("fto_tools") || hasPerm("fto_objectives_manage") || hasPerm("academy_manage")
      );

      allow create: if hasPerm("fto_objectives_manage")
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.status == "Ouvert";

      allow update: if hasPerm("fto_objectives_manage")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status","completedAt","completedById","completedByName","updatedAt"
        ]);
      allow delete: if false;
    }

    match /final_fto_reviews/{id} {
      allow read: if isInternal() && (
        resource.data.traineeId == request.auth.uid || hasPerm("fto_tools") || hasPerm("academy_manage") || hasPerm("academy_final_review") || hasPerm("personnel_view") || hasPerm("analytics")
      );

      allow create: if hasPerm("academy_manage")
        && request.resource.data.ftoId == request.auth.uid
        && request.resource.data.status == "En attente Commandement";

      allow update: if hasPerm("academy_final_review")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status","reviewedById","reviewedByName","reviewedAt"
        ]);
      allow delete: if false;
    }


    match /academy_content/{moduleCode} {
      allow read: if hasPerm("training_access") || hasPerm("fto_tools") || hasPerm("academy_manage") || hasPerm("academy_content_manage");
      allow create, update: if hasPerm("academy_content_manage");
      allow delete: if false;
    }

    match /academy_scenarios/{id} {
      allow read: if hasPerm("training_access") || hasPerm("fto_tools") || hasPerm("academy_manage") || hasPerm("academy_content_manage");
      allow create, update: if hasPerm("academy_content_manage");
      allow delete: if false;
    }

    match /academy_quiz_attempts/{id} {
      allow read: if signedIn() && (
        ((hasPerm("training_access") || hasPerm("academy_manage")) && resource.data.officerId == request.auth.uid) || hasPerm("fto_tools") || hasPerm("academy_manage") || hasPerm("analytics")
      );
      allow create: if hasPerm("training_access")
        && request.resource.data.officerId == request.auth.uid;
      allow update, delete: if false;
    }

    match /fto_feedback/{id} {
      allow read: if signedIn() && (
        ((hasPerm("training_access") || hasPerm("academy_manage")) && resource.data.traineeId == request.auth.uid) || hasPerm("fto_tools") || hasPerm("academy_manage")
      );
      allow create: if hasPerm("training_access")
        && request.resource.data.traineeId == request.auth.uid;
      allow update, delete: if false;
    }

    match /fto_handoffs/{id} {
      allow read: if hasPerm("fto_tools") || hasPerm("academy_manage") || hasPerm("fto_handoffs_manage");
      allow create: if hasPerm("fto_handoffs_manage")
        && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
