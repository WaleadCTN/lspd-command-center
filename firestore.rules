rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myRole() {
      return signedIn() ? myProfile().data.role : null;
    }

    function isFTO() {
      return signedIn() && (
        myRole() == "FTO" ||
        myRole() == "Sergeant" ||
        myRole() == "Lieutenant" ||
        myRole() == "Captain" ||
        myRole() == "Deputy Chief" ||
        myRole() == "Assistant Chief" ||
        myRole() == "Chief"
      );
    }

    function isCommand() {
      return signedIn() && (
        myRole() == "Sergeant" ||
        myRole() == "Lieutenant" ||
        myRole() == "Captain" ||
        myRole() == "Deputy Chief" ||
        myRole() == "Assistant Chief" ||
        myRole() == "Chief"
      );
    }

    function isChief() {
      return signedIn() && myRole() == "Chief";
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        isFTO() ||
        isCommand()
      );

      allow create, update: if isChief();
      allow delete: if false;
    }

    match /evaluations/{evaluationId} {
      allow read: if signedIn() && (
        resource.data.officerId == request.auth.uid ||
        resource.data.ftoId == request.auth.uid ||
        isCommand()
      );

      allow create: if isFTO()
        && request.resource.data.ftoId == request.auth.uid
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100;

      allow update, delete: if false;
    }

    match /promotions/{promotionId} {
      allow read: if isCommand();
      allow create: if isChief()
        && request.resource.data.approvedById == request.auth.uid;
      allow update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isCommand();
      allow create: if isFTO()
        && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
